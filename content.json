{
  "Format": "2.8.0",
  "ConfigSchema": {
    "BoldEnabled": {
      "AllowValues": "true, false",
      "Default": true,
      "Section": "Bold Font"
    },
    "BoldNumerals": {
      "AllowValues": "Text, Lining",
      "Default": "Text",
      "Section": "Bold Font"
    },
    "BoldSS01": {
      "AllowValues": "Default, Plain",
      "Default": "Default",
      "Section": "Bold Font"
    },
    "SpriteEnabled": {
      "AllowValues": "true, false",
      "Default": true,
      "Section": "Sprite Fonts"
    },
    "SpriteNumerals": {
      "AllowValues": "Text, Lining",
      "Default": "Text",
      "Section": "Sprite Fonts"
    },
    "SpriteSS01": {
      "AllowValues": "Default, Plain",
      "Default": "Default",
      "Section": "Sprite Fonts"
    },
    "DummyValue": {
      "AllowBlank": true,
      "Default": "",
      "Section": "Bold Specimen"
    },
    "ColorMatch": {
      "AllowValues": "Auto, BogsForest, CatValley, EarthyInterface, LavenderDreams, LowkeySpring, MagicalValley, OvergrownFlowery, Vanilla",
      "Default": "Auto"
    }
  },
  "DynamicTokens": [
    {
      "Name": "SpriteFontTexture",
      "Value": "{{ModId}}/SpriteFont1x"
    },
    {
      "Name": "SpriteFontAltTexture",
      "Value": "{{ModId}}/SpriteFontAlt1x"
    },
    {
      "Name": "Sf1Scale",
      "Value": "300"
    },
    {
      "Name": "Sf1Scale",
      "Value": "200",
      "When": {
        "Language": "de, ru"
      }
    },
    {
      "Name": "BoldAltTexture",
      "Value": "{{ModId}}/font_bold_alt"
    },
    {
      "Name": "BoldExtraTexture",
      "Value": "{{ModId}}/font_bold_extra"
    },
    {
      "Name": "ColoredAltTexture",
      "Value": "{{ModId}}/font_colored_alt"
    },
    {
      "Name": "ColoredExtraTexture",
      "Value": "{{ModId}}/font_colored_extra"
    },

    // token to match active recolor. auto-detect installed UI recolors,
    // but override with user selection if not set to "Auto"
    {
      "Name": "MatchRecolor",
      "Value": ""
    },
    {
      "Name": "MatchRecolor",
      "Value": "EarthyInterface",
      "When": {
        "HasMod |contains=DaisyNiko.EarthyInterface": true
      }
    },
    {
      "Name": "MatchRecolor",
      "Value": "OvergrownFlowery",
      "When": {
        "HasMod |contains=Maraluna.OvergrownFloweryInterface": true
      }
    },
    {
      "Name": "MatchRecolor",
      "Value": "LowkeySpring",
      "When": {
        "HasMod |contains=Perlade.LowkeySpringUI": true
      }
    },
    {
      "Name": "MatchRecolor",
      "Value": "BogsForest",
      "When": {
        "HasMod |contains=Bos.UIInterface": true
      }
    },
    {
      "Name": "MatchRecolor",
      "Value": "LavenderDreams",
      "When": {
        "HasMod |contains=VinillaBean.LavenderDreams": true,
      }
    },
    {
      "Name": "MatchRecolor",
      "Value": "MagicalValley",
      "When": {
        "HasMod |contains=HReenna.MagicalValleyInterface": true
      }
    },
    {
      "Name": "MatchRecolor",
      "Value": "CatValley",
      "When": {
        "HasMod |contains=RimeNovi.CatValley": true
      }
    },
    {
      "Name": "MatchRecolor",
      "Value": "{{ColorMatch}}",
      "When": {
        "ColorMatch |contains=Auto": false
      }
    }
  ],
  "Changes": [
    // these loads are unconditional because the assets are new. gating them spits
    // warnings in the log if the gate closes and they aren't loaded anymore
    {
      "Target": "{{SpriteFontTexture}}, {{SpriteFontAltTexture}}, {{BoldAltTexture}}, {{BoldExtraTexture}}, {{ColoredAltTexture}}, {{ColoredExtraTexture}}",
      "Action": "Load",
      "FromFile": "assets/{{TargetWithoutPath}}.png",
      "Priority": "Exclusive"
    },

    {
      "Action": "Include",
      "FromFile": "data/bold-font.json",
      "When": {
        "BoldEnabled": true
      }
    },
    {
      "Action": "Include",
      "FromFile": "data/sprite-fonts.json",
      "When": {
        "SpriteEnabled": true
      }
    }
  ]
}
